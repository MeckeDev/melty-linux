{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melty Linux Client",
  "version": "0.1.0",
  "identifier": "gg.melty.linux-client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "panel"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "Unofficial native Linux client for melty.gg",
    "longDescription": "Community-built native Linux client for melty.gg (not affiliated with Melty)."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "melty"
        ]
      }
    }
  }
}
